APP_NAME="Ecommerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# Base de datos MySQL
# Crea la base antes de migrar:  CREATE DATABASE ecommerce_api CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# Autenticación (Laravel Sanctum)
# Minutos de vida de los tokens Bearer (1440 = 24 horas). Vacío = sin expiración.
# ----------------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=1440

# ----------------------------------------------------------------------
# Stripe  (https://dashboard.stripe.com/test/apikeys)
# Usa SIEMPRE claves de prueba (pk_test_ / sk_test_) en desarrollo.
# STRIPE_KEY            -> clave publicable, se entrega al frontend para Stripe.js
# STRIPE_SECRET         -> clave secreta, solo en el servidor (NUNCA en el frontend ni en git)
# STRIPE_WEBHOOK_SECRET -> firma de webhooks (whsec_...). Con Stripe CLI:
#                          stripe listen --forward-to localhost:8000/api/stripe/webhook
# STRIPE_CURRENCY       -> moneda ISO en minúsculas (usd, eur, clp...)
# ----------------------------------------------------------------------
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_••••••••••••••••••••••••
STRIPE_WEBHOOK_SECRET=whsec_xx••••••••••••••••••••••
STRIPE_CURRENCY=usd

# Impuesto aplicado al subtotal de cada orden (0.19 = 19%)
SHOP_TAX_RATE=0.19

# ----------------------------------------------------------------------
# Swagger / OpenAPI (darkaonline/l5-swagger) -> UI en /api/documentation
# ----------------------------------------------------------------------
L5_SWAGGER_CONST_HOST="${APP_URL}"
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true

# ----------------------------------------------------------------------
# Usuarios creados por los seeders (cámbialos en tu entorno)
# ----------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@ecommerce.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_EMAIL=cliente@ecommerce.test
SEED_CUSTOMER_PASSWORD=Cliente123!